DATABASE_URL="your-neon-dev-branch-url (local dev, any PC)"
# Prod Neon URL lives only in Vercel env + optional local PROD_DATABASE_URL for guard:
# PROD_DATABASE_URL="your-neon-prod-branch-url"
# Set ALLOW_PROD_SEED=true only for one-time fresh-prod seeding (wipes data).

AUTH_SECRET="your-auth-secret"

# Optional: comma-separated emails that skip manual approval and get admin on
# register/login. vegastristan1@gmail.com is always included by default.
# ADMIN_EMAILS="you@example.com"

# Optional: shared secret for the digest scheduler (GET /api/cron/digest?secret=...).
# CRON_SECRET="a-long-random-string"

OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="your-model"

# Optional: password-reset emails. Without RESEND_API_KEY the reset link is
# logged to the server console (works for local dev). Set both for real mail.
# For testing without a verified domain, use Resend's onboarding sender and
# send to your Resend account email:
# RESEND_API_KEY="your-resend-api-key"
# EMAIL_FROM="AI Developer Task Manager <onboarding@resend.dev>"
